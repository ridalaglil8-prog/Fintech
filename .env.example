# ---------------------------------------------------------------------------
# FinPilot AI - environment configuration template
#
# Copy this file to `.env` (which is git-ignored) and fill in your own values:
#     cp .env.example .env
#
# The application is fully functional WITHOUT any key: the demo dashboard,
# analytics, optimisation and stress testing never call an external service.
# A key is only required for the "AI Financial Assistant" page.
# ---------------------------------------------------------------------------

# --- LLM provider (OpenAI-compatible chat completions API) -----------------
# Any provider exposing /chat/completions works (OpenAI, Azure OpenAI
# compatible gateways, Mistral, Groq, Together, local Ollama/vLLM, ...).
LLM_API_KEY=
# Optional: override the API base URL (no trailing slash).
#   OpenAI          -> https://api.openai.com/v1
#   Groq            -> https://api.groq.com/openai/v1
#   Mistral         -> https://api.mistral.ai/v1
#   Local Ollama    -> http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
# Optional: model identifier used for explanations.
LLM_MODEL=gpt-4o-mini
# Optional: request timeout in seconds and output length cap.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2

# --- Optional: explicit FX rates ------------------------------------------
# FinPilot AI never guesses exchange rates. If (and only if) you provide an
# explicit rate, the app may convert allocations between currencies and will
# display the rate, its date and its source next to the converted total.
# Format: <FROM><TO>=<rate> (1 unit of FROM equals <rate> units of TO).
#FP_FX_RATE_USDMAD=
#FP_FX_RATE_DATE=

# --- Optional: application defaults ---------------------------------------
# Default language: en | fr
FP_DEFAULT_LANGUAGE=en
# Default data mode: demo | historical
FP_DEFAULT_DATA_MODE=demo
# Default market: US | MA
FP_DEFAULT_MARKET=US
